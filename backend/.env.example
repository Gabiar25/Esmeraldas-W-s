# Copia este archivo a ".env" y completa los valores reales.
# Nunca subas el archivo ".env" (con llaves reales) a un repositorio publico.

# Puerto donde corre el servidor
PORT=3000

# URL publica del sitio (sin barra al final). Se usa para armar el redirectUrl de Wompi
# y el link de confirmacion. En local puede quedar como http://localhost:3000
SITE_URL=http://localhost:3000

# --- Base de datos (PostgreSQL) ---
# Guarda los pedidos y el stock de forma permanente (sin esto se pierden en
# cada redeploy). Crea una base gratis en Render: New + -> PostgreSQL, y pega
# aqui la "Internal Database URL" (o "External Database URL" si conectas
# desde tu computador en local).
DATABASE_URL=postgres://usuario:password@host/nombre_basededatos

# --- Wompi (https://comercios.wompi.co) ---
# Crea una cuenta de PRUEBAS (sandbox) gratis e instantanea en https://comercios.wompi.co
# En "Desarrolladores" encontraras estas 3 llaves. Empiezan con *_test_ en sandbox
# y con *_prod_ cuando actives produccion (tras la verificacion de tu negocio).
WOMPI_PUBLIC_KEY=pub_test_XXXXXXXXXXXXXXXXXXXXXXXX
WOMPI_PRIVATE_KEY=prv_test_XXXXXXXXXXXXXXXXXXXXXXXX
WOMPI_INTEGRITY_SECRET=test_integrity_XXXXXXXXXXXXXXXXXXXXXXXX
WOMPI_EVENTS_SECRET=test_events_XXXXXXXXXXXXXXXXXXXXXXXX

# Ambiente de la API de Wompi: sandbox.wompi.co (pruebas) o production.wompi.co (real)
WOMPI_API_BASE=https://sandbox.wompi.co/v1

# Costo de envio en pesos (COP), se suma al total del pedido. 0 = envio gratis.
SHIPPING_COST=0
